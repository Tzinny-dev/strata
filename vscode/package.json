{
  "name": "strata-tzinny",
  "displayName": "Strata — Tzinny",
  "description": "Strata — declarative, versioned, immutable data transformations (LSP: diagnostics, completion, hover, definition)",
  "version": "0.1.4",
  "publisher": "Tzinny-dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tzinny-dev/strata.git"
  },
  "homepage": "https://github.com/Tzinny-dev/strata",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "strata",
    "sql",
    "data",
    "lsp"
  ],
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "strata",
        "aliases": [
          "Strata",
          "strata"
        ],
        "extensions": [
          ".strata"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "strata",
        "scopeName": "source.strata",
        "path": "./syntaxes/strata.tmLanguage.json"
      }
    ]
  },
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "lint": "eslint src --ext ts"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "@vscode/vsce": "^2.15.0"
  }
}
