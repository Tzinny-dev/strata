# build: bench/cases/store_simple/base.strata
model customer_revenue -> contract OrderRevenue
  fingerprint  41aecf4a9a798e5e
  outputs      customer_id: int64 nonnull, country: string nonnull, revenue: money(USD) nonnull, orders: int64 nonnull
  lineage customer_id <- orders.customer_id [grouped]
  lineage country <- customers.country [grouped]
  lineage revenue <- orders.gross_usd [aggregated]
  lineage orders <- orders.order_id [aggregated]
  reads        [('customer_revenue', 'country'), ('customers', 'country'), ('customers', 'customer_id'), ('orders', 'customer_id'), ('orders', 'gross_usd'), ('orders', 'order_id')]

# sql: duckdb
CREATE OR REPLACE VIEW v_customer_revenue AS
-- model customer_revenue -> contract OrderRevenue
WITH base AS (
SELECT t0.order_id, t0.customer_id, t0.gross_usd, t0.placed_at, t1.customer_id AS __j1_customer_id, t1.country AS __j1_country, t1.name AS __j1_name, t1.is_active AS __j1_is_active, t1.country AS country
FROM orders t0
  LEFT JOIN customers t1 ON (t0.customer_id = t1.customer_id)
)
SELECT customer_id AS customer_id, country AS country, SUM(gross_usd) AS revenue, COUNT(order_id) AS orders
FROM base
GROUP BY customer_id, country


